# 复制本文件为 .env 后按需修改

# 数据库（默认 SQLite，文件位于 server/yaolin.db）
# DATABASE_URL="sqlite:///./yaolin.db"

# JWT 配置（上线务必更换为随机长字符串）
JWT_SECRET="yaolin-dev-secret-change-me-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_MINUTES="10080"

# 允许跨域的前端地址（多个用英文逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# 服务监听端口
PORT="8000"

# 手机验证码：演示环境未接短信网关，true 时接口回传验证码便于联调，上线请设为 false
SMS_DEBUG="true"

# AI 识药：OpenRouter 密钥只保存在服务端，前端不再持有
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
